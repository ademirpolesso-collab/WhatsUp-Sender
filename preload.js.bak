/**
 * preload.js — bridge segura entre main process e renderer (contextIsolation)
 */
const { contextBridge, ipcRenderer } = require('electron');

contextBridge.exposeInMainWorld('api', {
  // WhatsApp
  waInit:          ()        => ipcRenderer.invoke('wa:init'),
  waStatus:        ()        => ipcRenderer.invoke('wa:status'),
  waInfo:          ()        => ipcRenderer.invoke('wa:info'),
  waDisconnect:    ()        => ipcRenderer.invoke('wa:disconnect'),
  waClearSession:  ()        => ipcRenderer.invoke('wa:clear-session'),
  onWaQr:       (cb)         => ipcRenderer.on('wa:qr',     (_, d) => cb(d)),
  onWaStatus:   (cb)         => ipcRenderer.on('wa:status', (_, d) => cb(d)),
  onWaReady:    (cb)         => ipcRenderer.on('wa:ready',  (_, d) => cb(d)),
  onWaError:    (cb)         => ipcRenderer.on('wa:error',  (_, d) => cb(d)),
  onWaAck:      (cb)         => ipcRenderer.on('wa:ack',    (_, d) => cb(d)),
  onWaReply:    (cb)         => ipcRenderer.on('wa:reply',  (_, d) => cb(d)),

  // Contatos
  contactsList:       ()      => ipcRenderer.invoke('contacts:list'),
  contactsAdd:        (n, p)  => ipcRenderer.invoke('contacts:add', n, p),
  contactsDelete:     (id)    => ipcRenderer.invoke('contacts:delete', id),
  contactsDeleteMany: (ids)   => ipcRenderer.invoke('contacts:delete-many', JSON.stringify(ids)),
  contactsDeleteAll:  ()      => ipcRenderer.invoke('contacts:delete-all'),
  contactsImportCsv:  ()      => ipcRenderer.invoke('contacts:import-csv'),

  // Mensagens
  messagesList:   ()              => ipcRenderer.invoke('messages:list'),
  messagesAdd:    (t, b)          => ipcRenderer.invoke('messages:add', t, b),
  messagesUpdate: (id, t, b)      => ipcRenderer.invoke('messages:update', id, t, b),
  messagesDelete: (id)            => ipcRenderer.invoke('messages:delete', id),

  // Associações
  assignmentsList:   ()           => ipcRenderer.invoke('assignments:list'),
  assignmentsSet:    (cId, mId)   => ipcRenderer.invoke('assignments:set', cId, mId),
  assignmentsDelete: (id)         => ipcRenderer.invoke('assignments:delete', id),

  // Log
  logList:  ()  => ipcRenderer.invoke('log:list'),
  logClear: ()  => ipcRenderer.invoke('log:clear'),

  // Scheduler
  schedulerRun:       (jobs, bs, ds) => ipcRenderer.invoke('scheduler:run', jobs, bs, ds),
  schedulerCancel:    ()             => ipcRenderer.invoke('scheduler:cancel'),
  schedulerIsRunning: ()             => ipcRenderer.invoke('scheduler:is-running'),
  onSchedulerStart:    (cb) => ipcRenderer.on('scheduler:start',    (_, d) => cb(d)),
  onSchedulerProgress: (cb) => ipcRenderer.on('scheduler:progress', (_, d) => cb(d)),
  onSchedulerWaiting:  (cb) => ipcRenderer.on('scheduler:waiting',  (_, d) => cb(d)),
  onSchedulerDone:     (cb) => ipcRenderer.on('scheduler:done',     (_, d) => cb(d)),

  // Serena Bot & Dashboard
  serenaDashboard:      (dateFilter) => ipcRenderer.invoke('serena:dashboard', dateFilter),
  serenaRecentActivity: (limit)      => ipcRenderer.invoke('serena:recent-activity', limit),
  serenaAppointments:   ()           => ipcRenderer.invoke('serena:appointments'),
  serenaMessages:       (phone)      => ipcRenderer.invoke('serena:messages', phone),
  serenaResetAll:       ()           => ipcRenderer.invoke('serena:reset-all'),
  serenaResetLead:      (phone)      => ipcRenderer.invoke('serena:reset-lead', phone),

  // Feriados
  holidaysListNational: (year)       => ipcRenderer.invoke('holidays:list-national', year),
  holidaysListCustom:   ()           => ipcRenderer.invoke('holidays:list-custom'),
  holidaysAddCustom:    (d, desc)    => ipcRenderer.invoke('holidays:add-custom', d, desc),
  holidaysDeleteCustom: (id)         => ipcRenderer.invoke('holidays:delete-custom', id),

  // Config
  configGet: ()       => ipcRenderer.invoke('config:get'),
  configSet: (k, v)   => ipcRenderer.invoke('config:set', k, v),

  // Zelda
  zeldaListActive:        ()                 => ipcRenderer.invoke('zelda:list-active'),
  zeldaListArchived:      ()                 => ipcRenderer.invoke('zelda:list-archived'),
  zeldaMessages:          (limit)            => ipcRenderer.invoke('zelda:messages', limit),
  zeldaDetail:            (seq)              => ipcRenderer.invoke('zelda:detail', seq),
  zeldaCreateInitiative:  (params)           => ipcRenderer.invoke('zelda:create-initiative', params),
  zeldaUpdateStatus:      (params)           => ipcRenderer.invoke('zelda:update-status', params),
  zeldaArchiveAll:        ()                 => ipcRenderer.invoke('zelda:archive-all'),
});

